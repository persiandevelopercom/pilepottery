# Set all values before deploying. Never commit your actual .env file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
SITE_URL=https://pilepottery.ir
# Optional persistent SQLite directory; default is .data in project root
DATA_DIR=
